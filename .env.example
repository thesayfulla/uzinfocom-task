# Template for .env
# Copy with: cp .env.example .env
# Then replace the values below.

# --- Postgres ---
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8080
DATABASE_URL=postgresql://postgres:change-me@db:5432/app
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cronjob ---
PAYMENT_TIMEOUT=15
